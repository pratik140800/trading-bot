# ==============================================================================
# 5. MAIN SCANNER
# ==============================================================================
results = []
print("📡 Scanning latest market data...")
print("-" * 80)

for ticker in WATCHLIST:
    daily, hourly = fetch_data(ticker)
    
    if daily.empty:
        results.append({'Ticker': ticker, 'Signal': 'NO DATA', 'Latest Price': 'N/A', 'Daily Trend': 'N/A'})
        continue

    daily_df = calculate_green_red(daily)
    if daily_df.empty:
        results.append({'Ticker': ticker, 'Signal': 'NO DATA', 'Latest Price': 'N/A', 'Daily Trend': 'N/A'})
        continue

    daily_latest = daily_df.tail(1).iloc[0]
    daily_bullish = daily_latest['Green'] > daily_latest['Red']

    signal = "HOLD ➖"
    latest_price = f"{daily_latest['Close']:.2f}"
    trend_text = "BULLISH 📈" if daily_bullish else "BEARISH 📉"
    
    # Default Hourly Values
    hourly_trend = "N/A"
    last_hour_signal = "N/A"
    candle_close_time = "N/A"

    if not hourly.empty and len(hourly) > 30:
        hourly_df = calculate_green_red(hourly)
        if not hourly_df.empty:
            hourly_latest = hourly_df.tail(1).iloc[0]
            hourly_prev = hourly_df.tail(2).iloc[0]

            # Capture Hourly Stats
            hourly_trend = "BULLISH 📈" if hourly_latest['Green'] > hourly_latest['Red'] else "BEARISH 📉"
            # Add 1 hour to the start time to get the correct close time
            # Convert UTC timestamp to IST (UTC + 5:30) and then format it
            candle_close_time = (hourly_latest.name + pd.Timedelta(hours=1) + pd.Timedelta(hours=5, minutes=30)).strftime('%H:%M')

            # Determine Last Hour Signal
            hourly_cross_up = (hourly_latest['Green'] > hourly_latest['Red']) and (hourly_prev['Green'] <= hourly_prev['Red'])
            hourly_cross_down = (hourly_latest['Green'] < hourly_latest['Red']) and (hourly_prev['Green'] >= hourly_prev['Red'])
            
            if hourly_cross_up and daily_bullish:
                last_hour_signal = "BUY 🟢"
            elif hourly_cross_down and not daily_bullish:
                last_hour_signal = "SELL 🔴"
            elif hourly_cross_down and daily_bullish:
                last_hour_signal = "EXIT LONG ⚠️"
            elif hourly_cross_up and not daily_bullish:
                last_hour_signal = "EXIT SHORT ⚠️"
            else:
                last_hour_signal = "HOLD ➖"

            # Current Action (based on last hour)
            if hourly_cross_up and daily_bullish:
                signal = "BUY 🟢"
            elif hourly_cross_down and not daily_bullish:
                signal = "SELL 🔴"
            elif hourly_cross_down and daily_bullish:
                signal = "EXIT LONG ⚠️"
            elif hourly_cross_up and not daily_bullish:
                signal = "EXIT SHORT ⚠️"
            
            latest_price = f"{hourly_latest['Close']:.2f}"

    results.append({
        'Ticker': ticker,
        'Latest Price': latest_price,
        'Daily Trend': trend_text,
        'Hourly Trend': hourly_trend,
        'Last Hour Signal': last_hour_signal,
        'Candle Close Time': candle_close_time,
        'Signal': signal
    })

# ==============================================================================
# 6. PRINT RESULTS
# ==============================================================================
